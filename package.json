{
  "name": "hackcable",
  "version": "0.0.3",
  "description": "Arduino and ESP32 simulator (Components wiring + code emulation)",
  "main": "dist/bundle.js",
  "types": "dist/types/src/main.d.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build:types": "tsc --emitDeclarationOnly",
    "build:src": "webpack --mode=production",
    "build:web": "webpack --mode=production --config ./webpack.config.web.js",
    "serve:web": "npx webpack serve --mode=development --config ./webpack.config.web.js"
  },
  "exports": {
    ".": "./dist/src/bundle.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClementGre/HackCable.git"
  },
  "author": "Clément Grennerat",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/ClementGre/HackCable/issues"
  },
  "homepage": "https://github.com/ClementGre/HackCable#readme",
  "keywords": [],
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "7.28.5",
    "@types/jquery": "^4.0.0",
    "@types/react": "^19.2.14",
    "babel-loader": "^10.1.1",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "draw2d-types": "^1.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.6",
    "style-loader": "^4.0.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^8.1.3",
    "typescript": "6.0.2",
    "webpack": "5.106.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "canvg": "^4.0.3",
    "class": "^0.1.4",
    "draw2d": "^1.0.38",
    "intel-hex": "^0.2.0",
    "jquery": "^4.0.0",
    "jquery-autosize": "^1.18.18",
    "jquery-contextmenu": "^2.10.1",
    "jquery-ui": "^1.14.2",
    "jquery-ui-touch-punch": "^0.2.3",
    "pathfinding": "^0.4.18",
    "raphael": "^2.3.0",
    "rgbcolor": "^1.0.1",
    "shifty": "^3.0.6"
  }
}
