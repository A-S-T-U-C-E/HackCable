{
  "name": "hackcable",
  "version": "1.0.0",
  "description": "Arduino and ESP32 simulator (Components wiring + code emulation)",
  "main": "dist/bundle.js",
  "types": "dist/types/src/main.d.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build:types": "tsc --emitDeclarationOnly",
    "build:src": "webpack --mode=production",
    "build:web": "webpack --mode=production --config ./webpack.config.web.js",
    "serve:web": "npx webpack serve --mode=development --config ./webpack.config.web.js"
  },
  "exports": {
    ".": "./dist/src/bundle.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-S-T-U-C-E/HackCable.git"
  },
  "author": "Clément Grennerat",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/A-S-T-U-C-E/HackCable/issues"
  },
  "homepage": "https://github.com/A-S-T-U-C-E/HackCable#readme",
  "keywords": [],
  "overrides": {
    "xmldom": "npm:@xmldom/xmldom@^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.2.18",
    "babel-loader": "^10.1.1",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "draw2d-types": "^1.0.3",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^9.0.0",
    "typescript": "7.0.2",
    "webpack": "5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "class": "^0.1.4",
    "draw2d": "^1.0.38",
    "i18next": "^26.4.2",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "pathfinding": "^0.4.18",
    "raphael": "^2.3.0",
    "rgbcolor": "^1.0.1",
    "shifty": "^3.0.6"
  }
}
